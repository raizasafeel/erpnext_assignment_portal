{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"allowImportingTsExtensions": true,
		"strict": true,
		"jsx": "preserve",
		"types": ["vite/client", "vitest/globals", "node"],
		"baseUrl": ".",
		"paths": { "@/*": ["src/*"] },
		"skipLibCheck": true,
		"noEmit": true
	},
	"include": ["src/**/*.ts", "src/**/*.vue"]
}
